<UserControl x:Class="AirlineReservationSystem.UI.UserControls.ClearableTextbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AirlineReservationSystem.UI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250">
    <Grid>
        <TextBox Name="txtInput" VerticalContentAlignment="Center" FontSize="16" FontWeight="Light"/>
        <TextBlock Name="tbPlaceholder" Text="Text eingeben" FontSize="16" FontWeight="Light" Foreground="DarkGray" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <Button Name="btnClear" Width="50" HorizontalAlignment="Right" Content="Clear" Background="Transparent" Foreground="LightGray" BorderThickness="0"/>
    </Grid>
</UserControl>
